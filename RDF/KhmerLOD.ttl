###  http://www.semanticweb.org/ontologies/2026/khmerLOD/PUB_00003
khmer:PUB_00003 rdf:type owl:NamedIndividual ,
                         bibo:Article ;
                dcterms:accessRights <http://purl.org/coar/access_right/c_abf2> ;
