           dcterms:title "What to Do about \"The Khmers\"" .


###  http://www.semanticweb.org/ontologies/2026/khmerLOD/PUB_00056
:PUB_00056 rdf:type owl:NamedIndividual ,
                    bibo:Article ;
           dcterms:creator :AUTH_BEPORTE ;
           dcterms:isPartOf :J15_VOL59 ;
