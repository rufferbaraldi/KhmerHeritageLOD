###  http://www.semanticweb.org/ontologies/2026/khmerLOD/PUB_00006
khmer:PUB_00006 rdf:type owl:NamedIndividual ,
                         bibo:Article ;
                dct:accessRights coar:c_abf2 ;
                dct:creator khmer:AUTH_CHFISCHER ,
                                khmer:AUTH_FECARO ,
                                khmer:AUTH_JAGDOUGLAS ;
