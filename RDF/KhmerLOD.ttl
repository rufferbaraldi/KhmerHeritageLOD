@prefix : <http://www.semanticweb.org/ontologies/2026/khmerLOD/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix schema: <https://schema.org/> .
@prefix unesco: <http://vocabularies.unesco.org/thesaurus/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geoNames: <https://sws.geonames.org/> .
@base <http://www.semanticweb.org/ontologies/2026/khmerLOD/> .

<http://www.semanticweb.org/ontologies/2026/khmerLOD/> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
dcterms:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/date
dcterms:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by
crm:P1_is_identified_by rdf:type owl:AnnotationProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P82_at_some_time_within
crm:P82_at_some_time_within rdf:type owl:AnnotationProperty .


###  http://www.opengis.net/ont/geosparql#asWKT
geo:asWKT rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/01/geo/wgs84_pos#lat
wgs84:lat rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/01/geo/wgs84_pos#long
wgs84:long rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#hasTopConcept
skos:hasTopConcept rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#topConceptOf
skos:topConceptOf rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
foaf:name rdf:type owl:AnnotationProperty .


###  https://schema.org/contentUrl
schema:contentUrl rdf:type owl:AnnotationProperty ;
                  rdfs:range xsd:anyURL ;
                  rdfs:domain crm:E36_Visual_Item .


###  https://schema.org/keywords
schema:keywords rdf:type owl:AnnotationProperty .


###  https://schema.org/size
schema:size rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.opengis.net/ont/geosparql#wktLiteral
geo:wktLiteral rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#anyURL
xsd:anyURL rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:ObjectProperty ;
                rdfs:domain dcterms:BibliographicResource ;
                rdfs:range foaf:Person .


###  http://purl.org/dc/terms/isPartOf
dcterms:isPartOf rdf:type owl:ObjectProperty .


###  http://purl.org/dc/terms/language
dcterms:language rdf:type owl:ObjectProperty .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:ObjectProperty ;
                  rdfs:domain dcterms:BibliographicResource ;
                  rdfs:range foaf:Organization .


###  http://purl.org/dc/terms/spatial
dcterms:spatial rdf:type owl:ObjectProperty ;
                rdfs:domain foaf:Organization ;
                rdfs:range crm:E53_Place .


###  http://purl.org/dc/terms/subject
dcterms:subject rdf:type owl:ObjectProperty ;
                rdfs:domain dcterms:BibliographicResource ;
                rdfs:range owl:Thing .


###  http://purl.org/dc/terms/type
dcterms:type rdf:type owl:ObjectProperty ;
             rdfs:domain crm:E22_Human-Made_Object ;
             rdfs:range crm:E55_Type .


###  http://www.cidoc-crm.org/cidoc-crm/P101_had_as_general_use
crm:P101_had_as_general_use rdf:type owl:ObjectProperty ;
                            rdfs:domain crm:E22_Human-Made_Object ;
                            rdfs:range crm:E55_Type .


###  http://www.cidoc-crm.org/cidoc-crm/P103_was_intended_for
crm:P103_was_intended_for rdf:type owl:ObjectProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( crm:E22_Human-Made_Object
                                                      crm:E27_Site
                                                    )
                                      ] ;
                          rdfs:range skos:Concept .


###  http://www.cidoc-crm.org/cidoc-crm/P108i_was_produced_by
crm:P108i_was_produced_by rdf:type owl:ObjectProperty ;
                          rdfs:domain crm:E22_Human-Made_Object ;
                          rdfs:range crm:E12_Production .


###  http://www.cidoc-crm.org/cidoc-crm/P125_used_object_of_type
crm:P125_used_object_of_type rdf:type owl:ObjectProperty ;
                             rdfs:domain crm:E7_Activity ;
                             rdfs:range crm:E57_Material .


###  http://www.cidoc-crm.org/cidoc-crm/P138i_has_representation
crm:P138i_has_representation rdf:type owl:ObjectProperty ;
                             rdfs:domain [ rdf:type owl:Class ;
                                           owl:unionOf ( crm:E22_Human-Made_Object
                                                         crm:E27_Site
                                                       )
                                         ] ;
                             rdfs:range crm:E36_Visual_Item .


###  http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by
crm:P14_carried_out_by rdf:type owl:ObjectProperty ;
                       rdfs:domain crm:E7_Activity ;
                       rdfs:range [ rdf:type owl:Class ;
                                    owl:unionOf ( foaf:Organization
                                                  foaf:Person
                                                )
                                  ] .


###  http://www.cidoc-crm.org/cidoc-crm/P156_occupies
crm:P156_occupies rdf:type owl:ObjectProperty ;
                  rdfs:domain crm:E27_Site ;
                  rdfs:range crm:E53_Place .


###  http://www.cidoc-crm.org/cidoc-crm/P2_has_type
crm:P2_has_type rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P43_has_dimension
crm:P43_has_dimension rdf:type owl:ObjectProperty ;
                      rdfs:domain crm:E22_Human-Made_Object .


###  http://www.cidoc-crm.org/cidoc-crm/P44_has_condition
crm:P44_has_condition rdf:type owl:ObjectProperty ;
                      rdfs:domain crm:E27_Site ;
                      rdfs:range crm:E3_Condition_State .


###  http://www.cidoc-crm.org/cidoc-crm/P45_consists_of
crm:P45_consists_of rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( crm:E22_Human-Made_Object
                                                crm:E27_Site
                                              )
                                ] ;
                    rdfs:range crm:E57_Material .


###  http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of
crm:P46i_forms_part_of rdf:type owl:ObjectProperty ;
                       rdfs:domain crm:E27_Site ;
                       rdfs:range crm:E27_Site .


###  http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span
crm:P4_has_time-span rdf:type owl:ObjectProperty ;
                     rdfs:domain crm:E7_Activity ;
                     rdfs:range crm:E52_Time-Span .


###  http://www.cidoc-crm.org/cidoc-crm/P50_has_current_keeper
crm:P50_has_current_keeper rdf:type owl:ObjectProperty ;
                           rdfs:domain crm:E22_Human-Made_Object ;
                           rdfs:range foaf:Organization .


###  http://www.cidoc-crm.org/cidoc-crm/P55_has_current_location
crm:P55_has_current_location rdf:type owl:ObjectProperty ;
                             rdfs:domain crm:E22_Human-Made_Object ;
                             rdfs:range crm:E53_Place .


###  http://www.cidoc-crm.org/cidoc-crm/P70_documents
crm:P70_documents rdf:type owl:ObjectProperty ;
                  rdfs:domain dcterms:BibliographicResource ;
                  rdfs:range crm:E27_Site ,
                             crm:E7_Activity .


###  http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at
crm:P7_took_place_at rdf:type owl:ObjectProperty ;
                     rdfs:domain crm:E7_Activity ;
                     rdfs:range crm:E53_Place .


###  http://www.cidoc-crm.org/cidoc-crm/P89_falls_within
crm:P89_falls_within rdf:type owl:ObjectProperty ;
                     rdfs:domain crm:E53_Place ;
                     rdfs:range crm:E53_Place .


###  http://www.cidoc-crm.org/cidoc-crm/P8_took_place_on_or_within
crm:P8_took_place_on_or_within rdf:type owl:ObjectProperty ;
                               rdfs:domain crm:E7_Activity ;
                               rdfs:range crm:E27_Site .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#type
rdf:type rdf:type owl:ObjectProperty .


###  http://www.w3.org/2002/07/owl#sameAs
owl:sameAs rdf:type owl:ObjectProperty ;
           rdfs:domain owl:Thing ;
           rdfs:range owl:Thing .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:ObjectProperty .


###  http://xmlns.com/foaf/0.1/member
foaf:member rdf:type owl:ObjectProperty ;
            rdfs:domain foaf:Person ;
            rdfs:range foaf:Organization .


###  https://schema.org/funder
schema:funder rdf:type owl:ObjectProperty ;
              rdfs:domain crm:E7_Activity ;
              rdfs:range foaf:Organization .


###  https://schema.org/maintainer
schema:maintainer rdf:type owl:ObjectProperty ;
                  rdfs:domain crm:E7_Activity ;
                  rdfs:range foaf:Organization .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/ontology/bibo/issue
bibo:issue rdf:type owl:DatatypeProperty ;
           rdfs:domain bibo:Issue ;
           rdfs:range xsd:integer .


###  http://purl.org/ontology/bibo/number
bibo:number rdf:type owl:DatatypeProperty ;
            rdfs:domain bibo:Issue ;
            rdfs:range xsd:integer .


###  http://purl.org/ontology/bibo/volume
bibo:volume rdf:type owl:DatatypeProperty ;
            rdfs:domain bibo:Issue ;
            rdfs:range xsd:integer .


###  http://www.semanticweb.org/ontologies/2026/khmerLOD/projectStatus
:projectStatus rdf:type owl:DatatypeProperty ;
               rdfs:domain crm:E7_Activity ;
               rdfs:range [ rdf:type rdfs:Datatype ;
                            owl:oneOf [ rdf:type rdf:List ;
                                        rdf:first "Concluded" ;
                                        rdf:rest [ rdf:type rdf:List ;
                                                   rdf:first "Ongoing" ;
                                                   rdf:rest rdf:nil
                                                 ]
                                      ]
                          ] .


###  https://schema.org/endDate
schema:endDate rdf:type owl:DatatypeProperty ;
               rdfs:domain crm:E52_Time-Span ;
               rdfs:range xsd:gYear .


###  https://schema.org/startDate
schema:startDate rdf:type owl:DatatypeProperty ;
                 rdfs:domain crm:E52_Time-Span ;
                 rdfs:range xsd:gYear .


#################################################################
#    Classes
#################################################################

###  http://purl.org/dc/terms/BibliographicResource
dcterms:BibliographicResource rdf:type owl:Class .


###  http://purl.org/ontology/bibo/Article
bibo:Article rdf:type owl:Class ;
             rdfs:subClassOf dcterms:BibliographicResource ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty dcterms:isPartOf ;
                               owl:someValuesFrom bibo:Issue
                             ] .


###  http://purl.org/ontology/bibo/Book
bibo:Book rdf:type owl:Class ;
          rdfs:subClassOf dcterms:BibliographicResource .


###  http://purl.org/ontology/bibo/Chapter
bibo:Chapter rdf:type owl:Class ;
             rdfs:subClassOf dcterms:BibliographicResource ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty dcterms:isPartOf ;
                               owl:someValuesFrom bibo:Book
                             ] .


###  http://purl.org/ontology/bibo/Issue
bibo:Issue rdf:type owl:Class ;
           rdfs:subClassOf dcterms:BibliographicResource ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty dcterms:isPartOf ;
                             owl:someValuesFrom bibo:Journal
                           ] .


###  http://purl.org/ontology/bibo/Journal
bibo:Journal rdf:type owl:Class ;
             rdfs:subClassOf dcterms:BibliographicResource .


###  http://purl.org/ontology/bibo/Proceedings
bibo:Proceedings rdf:type owl:Class ;
                 rdfs:subClassOf dcterms:BibliographicResource .


###  http://purl.org/ontology/bibo/Thesis
bibo:Thesis rdf:type owl:Class ;
            rdfs:subClassOf dcterms:BibliographicResource .


###  http://www.cidoc-crm.org/cidoc-crm/E12_Production
crm:E12_Production rdf:type owl:Class .


###  http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object
crm:E22_Human-Made_Object rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty crm:P2_has_type ;
                                            owl:allValuesFrom crm:E55_Type
                                          ] .


###  http://www.cidoc-crm.org/cidoc-crm/E27_Site
crm:E27_Site rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty crm:P2_has_type ;
                               owl:allValuesFrom crm:E55_Type
                             ] .


###  http://www.cidoc-crm.org/cidoc-crm/E36_Visual_Item
crm:E36_Visual_Item rdf:type owl:Class .


###  http://www.cidoc-crm.org/cidoc-crm/E3_Condition_State
crm:E3_Condition_State rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty crm:P2_has_type ;
                                         owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                             owl:onProperty skos:inScheme ;
                                                             owl:hasValue :KhmerSiteCondition
                                                           ]
                                       ] .


###  http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span
crm:E52_Time-Span rdf:type owl:Class .


###  http://www.cidoc-crm.org/cidoc-crm/E53_Place
crm:E53_Place rdf:type owl:Class .


###  http://www.cidoc-crm.org/cidoc-crm/E55_Type
crm:E55_Type rdf:type owl:Class .


###  http://www.cidoc-crm.org/cidoc-crm/E57_Material
crm:E57_Material rdf:type owl:Class .


###  http://www.cidoc-crm.org/cidoc-crm/E7_Activity
crm:E7_Activity rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class .


