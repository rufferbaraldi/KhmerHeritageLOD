###  http://www.semanticweb.org/ontologies/2026/khmerLOD/PUB_00011
khmer:PUB_00011 rdf:type owl:NamedIndividual ,
                         bibo:Article ;
                dct:accessRights coar:c_16ec ;
                dct:creator khmer:AUTH_GIGREEN ;
                dct:isPartOf khmer:J62_VOL50_I4 ;
                dct:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
                dct:publisher khmer:PBSH_00009 ;
                dct:subject <http://vocab.getty.edu/aat/300054394> ;
                crm:P70_documents khmer:UNESCO_01 ;
                dct:abstract "Comparison of bas relief medallions at Angkor with medallion patterns on Chinese silk and Indian cotton textiles provides compelling evidence that fabrics from these regions were actually in use in the courts of Khmer kings. They served two purposes. One was as items of opulent palace decoration, this role transferred to stone temples, homes of the gods. Second, they represented a canopy or ceiling above a sacred space. Another group, here termed ``pseudomedallions,{''} is described and their function speculated on. While the original textiles at Angkor have long since disappeared, their representations in stone survive as a memorial to these practices."@en ;
                dct:date "2007"^^xsd:gYear ;
                dct:identifier "https://doi.org/10.1163/156852007783245025"^^xsd:anyURI ;
                dct:title "Angkor vogue: Sculpted evidence of imported luxury textiles in the courts of kings and temples"@en ;
                schema:keywords "Angkor"@en ,
                                "Material Culture" ,
                                "Textiles" .


###  http://www.semanticweb.org/ontologies/2026/khmerLOD/PUB_00012
khmer:PUB_00012 rdf:type owl:NamedIndividual ,
                         bibo:Book ;
                dct:accessRights coar:c_16ec ;
                dct:creator khmer:AUTH_SIMACKENZIE ,
                                khmer:AUTH_TEDAVIS ;
                dct:isPartOf khmer:BOOK_00002 ;
                dct:language <http://id.loc.gov/vocabulary/iso639-2/eng> ;
                dct:publisher khmer:PBSH_00009 ;
