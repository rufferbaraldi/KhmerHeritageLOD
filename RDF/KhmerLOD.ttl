###  http://www.semanticweb.org/ontologies/2026/khmerLOD/PUB_00057
:PUB_00057 rdf:type owl:NamedIndividual ,
                    bibo:Article ;
           dcterms:creator :AUTH_GECOEDES ;
           dcterms:isPartOf :J20_VOL31 ;
           dcterms:abstract "" ;
