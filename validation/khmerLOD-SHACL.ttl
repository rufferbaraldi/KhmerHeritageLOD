@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix kh:     <http://www.semanticweb.org/ontologies/2026/khmerLOD/> .
@prefix kh-sh:  <http://www.semanticweb.org/ontologies/2026/khmerLOD/shapes/> .
@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix bibo:   <http://purl.org/ontology/bibo/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix geo:    <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <http://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix wgs84:  <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:     <http://example.org/> .

############ TARGET: sites except the four UNESCO umbrella records ############

kh-sh:NonUmbrellaSite a sh:SPARQLTarget ;
  sh:prefixes <http://www.semanticweb.org/ontologies/2026/khmerLOD/shapes/> ;
  sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    PREFIX kh: <http://www.semanticweb.org/ontologies/2026/khmerLOD/>
    SELECT ?this WHERE {
      ?this a crm:E27_Site .
      FILTER (?this NOT IN (kh:UNESCO_01, kh:UNESCO_02, kh:UNESCO_03, kh:UNESCO_04))
    }""" .

############ SITES (E27) ############

# 01 Label required
kh-sh:Site_Label
    rdf:type sh:NodeShape ; sh:target kh-sh:NonUmbrellaSite ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype rdf:langString ;
    sh:message "01: Site must have an rdfs:label." ] .

# 02 Latitude: exactly one decimal in [-90, 90]
kh-sh:Site_Lat
    rdf:type sh:NodeShape ; sh:target kh-sh:NonUmbrellaSite ;
  sh:property [ sh:path wgs84:lat ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
    sh:minInclusive -90 ; sh:maxInclusive 90 ;
    sh:message "02: Site needs exactly one wgs84:lat (xsd:decimal, -90..90)." ] .

# 03 Longitude: exactly one decimal in [-180, 180]
kh-sh:Site_Long
    rdf:type sh:NodeShape ; sh:target kh-sh:NonUmbrellaSite ;
  sh:property [ sh:path wgs84:long ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
    sh:minInclusive -180 ; sh:maxInclusive 180 ;
    sh:message "03: Site needs exactly one wgs84:long (xsd:decimal, -180..180)." ] .

# 04 Plausible Cambodian bounding box (warning)
kh-sh:Site_BBox
    rdf:type sh:NodeShape ; sh:target kh-sh:NonUmbrellaSite ; sh:severity sh:Warning ;
  sh:property [ sh:path wgs84:lat  ; sh:minInclusive 10.0 ; sh:maxInclusive 15.0 ;
    sh:message "04: Latitude outside the Cambodia bounding box; check for swapped lat/long." ] ;
  sh:property [ sh:path wgs84:long ; sh:minInclusive 102.0 ; sh:maxInclusive 108.0 ;
    sh:message "04: Longitude outside the Cambodia bounding box; check for swapped lat/long." ] .

# 05 Exactly one condition state, correctly typed
kh-sh:Site_Condition
    rdf:type sh:NodeShape ; sh:target kh-sh:NonUmbrellaSite ;
  sh:property [ sh:path crm:P44_has_condition ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:class crm:E3_Condition_State ; sh:nodeKind sh:IRI ;
    sh:message "05: Site needs exactly one P44_has_condition pointing to an E3_Condition_State." ] .

# 06 Site type and location (administrative place)
kh-sh:Site_TypeLocation
    rdf:type sh:NodeShape ; sh:target kh-sh:NonUmbrellaSite ;
  sh:property [ sh:path crm:P2_has_type ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
    sh:message "06: Site needs at least one P2_has_type (IRI)." ] ;
  sh:property [ sh:path crm:P156_occupies ; sh:minCount 1 ; sh:class crm:E53_Place ;
    sh:message "06: Site must occupy an E53_Place." ] .

# 07 All non-umbrella sites must belong to one of the four UNESCO properties.
# The four UNESCO umbrella records are excluded because they are the parent entities.
kh-sh:Site_ToUnesco
    rdf:type sh:NodeShape ;
  sh:target kh-sh:NonUmbrellaSite ;
  sh:property [
    sh:path crm:P46i_forms_part_of ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( kh:UNESCO_01 kh:UNESCO_02 kh:UNESCO_03 kh:UNESCO_04 ) ;
    sh:message "07: Site must belong to one of the four UNESCO properties." ;
  ] .

ex:SiteToUnesco
    rdf:type sh:NodeShape ;
    sh:targetClass crm:E27_Site ;
 
# (IV) All sites must belong to one UNESCO property   
    sh:property [
        sh:path crm:P46i_forms_part_of ;
        sh:or (
            [sh:hasValue kh:UNESCO_01 ;]
            [sh:hasValue kh:UNESCO_02 ;]
            [sh:hasValue kh:UNESCO_03 ;]
            [sh:hasValue kh:UNESCO_04 ;]
            [sh:in ( kh:UNESCO_01 kh:UNESCO_02 kh:UNESCO_03 kh:UNESCO_04 ) ;]
        ) ;
    ] .

# 07 Condition state: needs a type from the controlled vocabulary + a label
kh-sh:Condition_State
    rdf:type sh:NodeShape ; sh:targetClass crm:E3_Condition_State ;
  sh:property [ sh:path crm:P2_has_type ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    sh:message "07: Condition state needs exactly one P2_has_type." ] ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ;
    sh:message "07: Condition state needs a label." ] .


############ PLACES (E53) ############

# 08 Place: validate labels only for locally described KhmerLOD places.
# External controlled-vocabulary/alignment URIs (e.g. GeoNames) are not required
# to duplicate labels from the external source in this dataset.
kh-sh:LocalPlaceTarget a sh:SPARQLTarget ;
  sh:select """
    PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
    PREFIX kh: <http://www.semanticweb.org/ontologies/2026/khmerLOD/>
    SELECT ?this WHERE {
      ?this a crm:E53_Place .
      FILTER(STRSTARTS(STR(?this), STR(kh:)))
    }
  """ .
kh-sh:Place
    rdf:type sh:NodeShape ; sh:target kh-sh:LocalPlaceTarget ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "09: Locally described place needs a label." ] ;
  sh:property [ sh:path crm:P89_falls_within ; sh:class crm:E53_Place ;
    sh:message "09: P89_falls_within must point to an E53_Place." ] .

############ PRODUCTION & TIME (E12, E52) ############

# 09 Production: one time-span, correctly typed
kh-sh:Production_TimeSpan
    rdf:type sh:NodeShape ; sh:targetClass crm:E12_Production ;
  sh:property [ sh:path crm:P4_has_time-span ; sh:minCount 1 ; sh:maxCount 1 ; sh:class crm:E52_Time-Span ;
    sh:message "10: Production needs exactly one P4_has_time-span (E52_Time-Span)." ] .

# 10 Production: at least one agent
kh-sh:Production_Agent
    rdf:type sh:NodeShape ; sh:targetClass crm:E12_Production ;
  sh:property [ sh:path crm:P14_carried_out_by ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
    sh:message "11: Production needs at least one P14_carried_out_by." ] .

# 11 Production: located via site OR place
kh-sh:Production_Location
    rdf:type sh:NodeShape ; sh:targetClass crm:E12_Production ;
  sh:or ( [ sh:path crm:P8_took_place_on_or_within ; sh:minCount 1 ]
          [ sh:path crm:P7_took_place_at ; sh:minCount 1 ] ) ;
  sh:message "12: Production needs P8_took_place_on_or_within or P7_took_place_at." .

# 12 Time-span: startDate is optional but, when present, must be one four-digit year.
# endDate is OPTIONAL for ongoing projects; when present, it must be one four-digit year.
# Validate lexical years with SPARQL to avoid validator-specific xsd:gYear handling.
kh-sh:TimeSpan_Datatypes
    rdf:type sh:NodeShape ; sh:targetClass crm:E52_Time-Span ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "13: startDate must be a four-digit year value (e.g. 1997)." ;
    sh:select """
      PREFIX schema: <http://schema.org/>
      SELECT $this ?value WHERE {
        $this schema:startDate ?value .
        FILTER (!REGEX(STR(?value), "^[0-9]{4}$"))
      }"""
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "13: endDate must be a four-digit year value (e.g. 2014)." ;
    sh:select """
      PREFIX schema: <http://schema.org/>
      SELECT $this ?value WHERE {
        $this schema:endDate ?value .
        FILTER (!REGEX(STR(?value), "^[0-9]{4}$"))
      }"""
  ] .

# 13 Time-span: compare dates only when BOTH startDate and endDate exist; ongoing spans without endDate are valid.
kh-sh:TimeSpan_Order
    rdf:type sh:NodeShape ; sh:targetClass crm:E52_Time-Span ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "14: startDate is later than endDate." ;
    sh:prefixes <http://www.semanticweb.org/ontologies/2026/khmerLOD/shapes/> ;
    sh:select """
      PREFIX schema: <http://schema.org/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT $this ?start ?end WHERE {
        $this schema:startDate ?start ; schema:endDate ?end .
        FILTER (xsd:integer(STR(?start)) > xsd:integer(STR(?end)))
      }""" ] .

# 14 Time-span: some temporal information (dates OR textual period)
kh-sh:TimeSpan_NotEmpty
    rdf:type sh:NodeShape ; sh:targetClass crm:E52_Time-Span ;
  sh:or ( [ sh:path schema:startDate ; sh:minCount 1 ]
          [ sh:path crm:P82_at_some_time_within ; sh:minCount 1 ] ) ;
  sh:message "15: Time-span has neither startDate nor P82_at_some_time_within." .

############ OBJECTS (E22, E36) ############

# 15 Object: core identification
kh-sh:Object_Core
    rdf:type sh:NodeShape ; sh:targetClass crm:E22_Human-Made_Object ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "16: Object needs a label." ] ;
  sh:property [ sh:path crm:P1_is_identified_by ; sh:minCount 1 ; sh:message "16: Object needs an identifier (P1)." ] ;
  sh:property [ sh:path dct:description ; sh:minCount 1 ; sh:minLength 1 ; sh:message "16: Object needs a non-empty description." ] .

# 16 Object: provenance chain (production, keeper, location)
kh-sh:Object_Links
    rdf:type sh:NodeShape ; sh:targetClass crm:E22_Human-Made_Object ;
  sh:property [ sh:path crm:P108i_was_produced_by ; sh:minCount 1 ; sh:class crm:E12_Production ;
    sh:message "17: Object must link to an E12_Production." ] ;
  sh:property [ sh:path crm:P50_has_current_keeper ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
    sh:message "17: Object needs a current keeper." ] ;
  sh:property [ sh:path crm:P55_has_current_location ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
    sh:message "17: Object needs a current location." ] .

# 17 Object: representation is a Visual Item; type and material present
kh-sh:Object_Representation
    rdf:type sh:NodeShape ; sh:targetClass crm:E22_Human-Made_Object ;
  sh:property [ sh:path crm:P138i_has_representation ; sh:minCount 1 ; sh:class crm:E36_Visual_Item ;
    sh:message "18: Object must have an E36_Visual_Item representation." ] ;
  sh:property [ sh:path crm:P2_has_type ; sh:minCount 1 ; sh:message "18: Object needs a P2_has_type." ] ;
  sh:property [ sh:path crm:P45_consists_of ; sh:minCount 1 ; sh:severity sh:Warning ;
    sh:message "18: Object has no material (P45_consists_of)." ] .

# 18 Visual item: image URL is an https?:// anyURI
kh-sh:VisualItem
    rdf:type sh:NodeShape ; sh:targetClass crm:E36_Visual_Item ;
  sh:property [ sh:path schema:contentUrl ; sh:minCount 1 ; sh:datatype xsd:anyURI ;
    sh:pattern "^https?://" ; sh:message "19: Visual item needs a schema:contentUrl (xsd:anyURI, http/https)." ] .

############ BIBLIOGRAPHIC TARGETS: BOOK_000XX records only need a title; identify by URI substring ############

kh-sh:NonStubPublication a sh:SPARQLTarget ;
  sh:prefixes <http://www.semanticweb.org/ontologies/2026/khmerLOD/shapes/> ;
  sh:select """
    PREFIX bibo: <http://purl.org/ontology/bibo/>
    SELECT ?this WHERE {
      ?this a ?type .
      VALUES ?type { bibo:Article bibo:Chapter bibo:Book bibo:Report bibo:Proceedings bibo:Thesis }
      FILTER (!CONTAINS(STR(?this), "BOOK_000"))
    }""" .

# Reports and BOOK_0000X title-only stubs do not need dct:subject.
# Use ordinary SHACL class targets here instead of a custom SPARQL target,
# and put the exclusion inside the constraint itself.
kh-sh:BookStubPublication a sh:SPARQLTarget ;
  sh:prefixes <http://www.semanticweb.org/ontologies/2026/khmerLOD/shapes/> ;
  sh:select """
    PREFIX bibo: <http://purl.org/ontology/bibo/>
    SELECT ?this WHERE {
      ?this a bibo:Book .
      FILTER (CONTAINS(STR(?this), "BOOK_0000"))
    }""" .

kh-sh:BookStub_Title
    rdf:type sh:NodeShape ; sh:target kh-sh:BookStubPublication ;
  sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:minLength 1 ;
    sh:message "20: BOOK_0000X requires only a non-empty dct:title." ] .

############ BIBLIOGRAPHIC RESOURCES ############

ex:PublicationShape
    rdf:type sh:NodeShape ;
    sh:targetClass bibo:Article, bibo:Report, bibo:Chapter, bibo:Thesis, bibo:Proceedings ;

# (I) Publication must have at least one author   
    sh:property [
        sh:path dct:creator;
        sh:minCount 1 ;
    ] ;

# (II) Publication must have at least one title
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
    ] ;
 
# (III) P70_documents values must be Site, Activity, or Object
    sh:property [
        sh:path crm:P70_documents ;
        sh:or (
            [ sh:class crm:E27_Site ]
            [ sh:class crm:E7_Activity ]
            [ sh:class crm:E22_Human-Made_Object ]
        ) ;
    ] .


# 19 Core bibliographic metadata (all publication types)
kh-sh:Biblio_Core
    rdf:type sh:NodeShape ;
  sh:target kh-sh:NonStubPublication ;
  sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:minLength 1 ; sh:message "20: Publication needs a non-empty title." ] ;
  sh:property [ sh:path dct:creator ; sh:minCount 1 ; sh:class foaf:Person ; sh:message "20: Publication needs at least one dct:creator (foaf:Person)." ] ;
  sh:property [ sh:path dct:date ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:gYear ; sh:message "20: Publication needs exactly one dct:date (xsd:gYear)." ] ;
  sh:property [ sh:path dct:language ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:message "20: Publication needs a dct:language IRI." ] ;
  sh:property [ sh:path dct:publisher ; sh:minCount 1 ; sh:class foaf:Organization ; sh:message "20: Publication needs a publisher (foaf:Organization)." ] .

# 20 Publication links to the heritage entity it documents
kh-sh:Biblio_Documents
    rdf:type sh:NodeShape ;
  sh:target kh-sh:NonStubPublication ;
  sh:property [
    sh:path crm:P70_documents ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:class crm:E27_Site ]
      [ sh:class crm:E7_Activity ]
      [ sh:class crm:E22_Human-Made_Object ]
    ) ;
    sh:message "21: Publication must document at least one Site, Activity, or Human-Made Object (P70_documents)." ;
  ] .

kh-sh:Biblio_Subject
    rdf:type sh:NodeShape ;
  sh:targetClass bibo:Article, bibo:Chapter, bibo:Book, bibo:Proceedings, bibo:Thesis ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Warning ;
    sh:message "21: Publication has no dct:subject (not required for reports or BOOK_0000X stubs)." ;
    sh:select """
      PREFIX dct: <http://purl.org/dc/terms/>
      SELECT $this WHERE {
        FILTER (!CONTAINS(STR($this), "BOOK_000"))
        FILTER NOT EXISTS { $this dct:subject ?subject . }
      }"""
  ] .

# 21 Access rights: exactly one IRI, either a COAR URI directly or a URI
# explicitly aligned to a COAR concept with owl:sameAs. SHACL does not infer
# owl:sameAs automatically, so the alignment is checked explicitly here.
kh-sh:Biblio_Access
    rdf:type sh:NodeShape ;
  sh:target kh-sh:NonStubPublication ;
  sh:property [ sh:path dct:accessRights ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    sh:message "22: Publication needs exactly one dct:accessRights IRI." ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "22: dct:accessRights must be a COAR access-right URI or be linked to one with owl:sameAs." ;
    sh:select """
      PREFIX dct: <http://purl.org/dc/terms/>
      PREFIX owl: <http://www.w3.org/2002/07/owl#>
      SELECT $this ?rights WHERE {
        $this dct:accessRights ?rights .
        FILTER NOT EXISTS {
          {
            FILTER(STRSTARTS(STR(?rights), "http://purl.org/coar/access_right/c_"))
          }
          UNION
          {
            ?rights owl:sameAs ?coar .
            FILTER(STRSTARTS(STR(?coar), "http://purl.org/coar/access_right/c_"))
          }
          UNION
          {
            ?coar owl:sameAs ?rights .
            FILTER(STRSTARTS(STR(?coar), "http://purl.org/coar/access_right/c_"))
          }
        }
      }""" ] .

# 22 Identifier and abstract quality
# DOI URLs must be literals typed xsd:anyURI. Non-DOI identifiers may be literals
# (for example ISBNs); resource IRIs are not valid dct:identifier values.
kh-sh:Biblio_Identifier
    rdf:type sh:NodeShape ;
  sh:target kh-sh:NonStubPublication ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:severity sh:Warning ;
    sh:message "23: DOI identifiers must be DOI URL literals typed xsd:anyURI; non-DOI identifiers must be literals." ;
    sh:select """
      PREFIX dct: <http://purl.org/dc/terms/>
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT $this ?identifier WHERE {
        $this dct:identifier ?identifier .
        FILTER(
          isIRI(?identifier) ||
          (REGEX(STR(?identifier), "^https?://(dx[.])?doi[.]org/10[.]", "i") && DATATYPE(?identifier) != xsd:anyURI)
        )
      }""" ] ;
  sh:property [ sh:path dct:abstract ; sh:minLength 1 ; sh:severity sh:Warning ;
    sh:message "23: dct:abstract is present but empty." ] .

# 23 Article → Issue → Journal hierarchy, with numeric volume/issue
kh-sh:Article_Issue
    rdf:type sh:NodeShape ; sh:targetClass bibo:Article ;
  sh:property [ sh:path dct:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bibo:Issue ;
    sh:message "24: Article must belong to exactly one bibo:Issue." ] .
kh-sh:Issue_Journal
    rdf:type sh:NodeShape ; sh:targetClass bibo:Issue ;
  sh:property [ sh:path dct:isPartOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class bibo:Journal ;
    sh:message "24: Issue must belong to exactly one bibo:Journal." ] ;
  sh:property [ sh:path bibo:volume ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:message "24: volume must be a positive xsd:integer." ] ;
  sh:property [ sh:path bibo:issue  ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:message "24: issue must be a positive xsd:integer." ] ;
  sh:property [ sh:path bibo:number ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:message "24: number must be a positive xsd:integer." ] .

############ AGENTS (Person, Organization, Journal) ############

# 24 Person / Organization / Journal naming
# Only require names on locally described KhmerLOD people. External authority
# records and controlled-vocabulary URIs are not expected to repeat labels/names.
kh-sh:LocalPersonTarget a sh:SPARQLTarget ;
  sh:select """
    PREFIX foaf: <http://xmlns.com/foaf/0.1/>
    PREFIX kh: <http://www.semanticweb.org/ontologies/2026/khmerLOD/>
    SELECT ?this WHERE {
      ?this a foaf:Person .
      FILTER(STRSTARTS(STR(?this), STR(kh:)))
    }
  """ .
kh-sh:Person_Name
    rdf:type sh:NodeShape ; sh:target kh-sh:LocalPersonTarget ;
  sh:property [ sh:path foaf:name ; sh:minCount 1 ; sh:minLength 1 ;
    sh:severity sh:Warning ;
    sh:message "25: Locally described person should have a non-empty foaf:name when known." ] ;
  sh:property [ sh:path owl:sameAs ; sh:nodeKind sh:IRI ; sh:message "25: owl:sameAs must be an IRI." ] .
kh-sh:Org_Name
    rdf:type sh:NodeShape ; sh:targetClass foaf:Organization ;
  sh:property [ sh:path foaf:name ; sh:minCount 1 ; sh:minLength 1 ; sh:message "25: Organization needs a non-empty foaf:name." ] ;
  sh:property [ sh:path foaf:member ; sh:class foaf:Person ; sh:message "25: foaf:member must be a foaf:Person." ] .
kh-sh:Journal_Title
    rdf:type sh:NodeShape ; sh:targetClass bibo:Journal ;
  sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:message "25: Journal needs a dct:title." ] .

<http://www.semanticweb.org/ontologies/2026/khmerLOD/shapes/> a owl:Ontology ;
  sh:declare [ sh:prefix "schema" ; sh:namespace "http://schema.org/"^^xsd:anyURI ] ,
             [ sh:prefix "crm" ; sh:namespace "http://www.cidoc-crm.org/cidoc-crm/"^^xsd:anyURI ] ,
             [ sh:prefix "kh" ; sh:namespace "http://www.semanticweb.org/ontologies/2026/khmerLOD/"^^xsd:anyURI ] ,
             [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .
